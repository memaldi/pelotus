{
  "name": "pelotus-modern",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:generate": "npm run --workspace @pelotus/db prisma:generate",
    "db:migrate": "npm run --workspace @pelotus/db prisma:migrate"
  },
  "devDependencies": {
    "turbo": "^2.0.12"
  }
}
